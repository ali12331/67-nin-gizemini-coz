}


/* =========================================================
   EV GÖREV SİSTEMİ
========================================================= */

function updateHomeObjective(){

    const text=
        document.getElementById(
            "objectiveText"
        );

    if(game==="oasis"){

        text.textContent=
            "Evini bul. Uzaklarda bir yerde.";

        return;
    }


    if(game==="house"){

        switch(home.task){

            case 0:
                text.textContent=
                    "1. Dolabı aç ve içindeki yemeği al.";
                break;

            case 1:
                text.textContent=
                    "2. Mikrodalgaya git ve yemeği içine koy.";
                break;

            case 2:
                text.textContent=
                    "3. Mikrodalgayı çalıştır. Pişmesini bekle.";
                break;

            case 3:
                text.textContent=
                    "4. Televizyonu aç.";
                break;

            case 4:
                text.textContent=
                    "5. Pişen yemeği mikrodalgadan çıkar.";
                break;

            case 5:
                text.textContent=
                    "6. Yemeği masaya götür.";
                break;

            case 6:
                text.textContent=
                    "7. Televizyonu aç ve yemek yemeye başla.";
                break;

            case 7:
                text.textContent=
                    "8. Tabağı mutfak lavabosuna götür.";
                break;

            case 8:
                text.textContent=
                    "9. Televizyonu kapat.";
                break;

            case 9:
                text.textContent=
                    "10. Üst kata çık.";
                break;

        }

    }


    if(game==="upstairs"){

        text.textContent=
            "11. Yatağa git ve E'ye bas.";
    }
}


/* =========================================================
   EV ETKİLEŞİMLERİ
========================================================= */

function interactHouse(){

    /*
       0
       DOLAP
    */

    if(home.task===0){

        if(
            distance(
                player.x,
                player.y,
                home.cabinet.x,
                home.cabinet.y
            )<2
        ){

            if(
                home.cabinet.open<.9
            ){

                home.cabinet.target=1;

                showMessage(
                    "Dolabı açıyorsun..."
                );

                setTimeout(()=>{

                    home.cabinet.foodTaken=true;
                    home.food=true;

                    home.task=1;

                    updateHomeObjective();

                    showMessage(
                        "🍲 Yemeği aldın.<br>"+
                        "Şimdi mikrodalgaya götür."
                    );

                },900);

            }

            return;
        }
    }


    /*
       1
       MİKRODALGAYA YEMEK KOY
    */

    if(home.task===1){

        if(
            distance(
                player.x,
                player.y,
                home.microwave.x,
                home.microwave.y
            )<2
        ){

            home.microwave.targetDoor=1;

            setTimeout(()=>{

                home.microwave.foodInside=true;
                home.food=false;

                home.task=2;

                updateHomeObjective();

                showMessage(
                    "Yemeği mikrodalgaya koydun.<br>"+
                    "E'ye tekrar basıp çalıştır."
                );

            },500);

            return;
        }
    }


    /*
       2
       MİKRODALGA ÇALIŞTIR
    */

    if(home.task===2){

        if(
            distance(
                player.x,
                player.y,
                home.microwave.x,
                home.microwave.y
            )<2
        ){

            if(
                !home.microwave.cooking
            ){

                home.microwave.cooking=true;
                home.microwave.cookTimer=5;

                showMessage(
                    "♨ Mikrodalga çalışıyor...<br>"+
                    "Yemek pişiyor."
                );

                return;
            }
        }
    }


    /*
       3
       TV AÇ
    */

    if(home.task===3){

        if(
            distance(
                player.x,
                player.y,
                home.tv.x,
                home.tv.y
            )<2.3
        ){

            home.tv.on=true;

            home.task=4;

            updateHomeObjective();

            showMessage(
                "📺 Televizyonu açtın."
            );

            return;
        }
    }


    /*
       4
       PİŞMİŞ YEMEĞİ AL
    */

    if(home.task===4){

        if(
            distance(
                player.x,
                player.y,
                home.microwave.x,
                home.microwave.y
            )<2
        ){

            home.microwave.targetDoor=1;

            setTimeout(()=>{

                home.microwave.foodInside=false;
                home.cookedFood=true;

                home.task=5;

                updateHomeObjective();

                showMessage(
                    "🍲 Yemek hazır!<br>"+
                    "Şimdi masaya götür."
                );

            },450);

            return;
        }
    }


    /*
       5
       MASAYA
    */

    if(home.task===5){

        if(
            distance(
                player.x,
                player.y,
                home.table.x,
                home.table.y
            )<2.3
        ){

            home.plate=true;
            home.cookedFood=false;

            home.task=6;

            updateHomeObjective();

            showMessage(
                "Yemeği masaya koydun."
            );

            return;
        }
    }


    /*
       6
       TV + YEMEK
    */

    if(home.task===6){

        if(
            distance(
                player.x,
                player.y,
                home.tv.x,
                home.tv.y
            )<2.3
        ){

            home.tv.on=true;

            home.eating=true;

            home.task=7;

            updateHomeObjective();

            showMessage(
                "📺 Film başladı.<br>"+
                "🍲 Yemeğini yiyorsun..."
            );

            setTimeout(()=>{

                if(
                    home.task===7
                ){

                    home.eating=false;

                    home.task=8;

                    updateHomeObjective();

                    showMessage(
                        "Yemeğini bitirdin.<br>"+
                        "Tabak lavaboya gitmeli."
                    );
                }

            },4500);

            return;
        }
    }


    /*
       7
       LAVABO
    */

    if(home.task===7){

        if(
            distance(
                player.x,
                player.y,
                home.sink.x,
                home.sink.y
            )<2
        ){

            home.plate=false;

            home.task=8;

            updateHomeObjective();

            showMessage(
                "🍽 Tabağı lavaboya bıraktın."
            );

            return;
        }
    }


    /*
       8
       TV KAPAT
    */

    if(home.task===8){

        if(
            distance(
                player.x,
                player.y,
                home.tv.x,
                home.tv.y
            )<2.3
        ){

            home.tv.on=false;

            home.task=9;

            updateHomeObjective();

            showMessage(
                "Televizyonu kapattın.<br>"+
                "Artık yukarı çık."
            );

            return;
        }
    }


    /*
       9
       MERDİVEN
    */

    if(home.task===9){

        if(
            distance(
                player.x,
                player.y,
                home.stairs.x,
                home.stairs.y
            )<2.4
        ){

            enterUpstairs();

            return;
        }
    }
}


/* =========================================================
   ÜST KAT ETKİLEŞİM
========================================================= */

function interactUpstairs(){

    if(
        distance(
            player.x,
            player.y,
            home.bed.x,
            home.bed.y
        )<2.5
    ){

        sleep();

    }else{

        showMessage(
            "Yatak odasında yatağa git."
        );
    }
}


/* =========================================================
   UYUMA
========================================================= */

function sleep(){

    started=false;

    const fade=
        document.getElementById("fade");

    fade.style.opacity="1";

    setTimeout(()=>{

        document.getElementById(
            "ending"
        ).style.display="flex";

    },900);
}


/* =========================================================
   MİKRODALGA GÜNCELLEME
========================================================= */

function updateMicrowave(dt){

    if(
        game!=="house"
    )
        return;


    /*
       Kapı animasyonu
    */

    const speed=3.5;

    if(
        home.microwave.door<
        home.microwave.targetDoor
    ){

        home.microwave.door=
            Math.min(
                home.microwave.targetDoor,
                home.microwave.door+
                dt*speed
            );

    }else if(
        home.microwave.door>
        home.microwave.targetDoor
    ){

        home.microwave.door=
            Math.max(
                home.microwave.targetDoor,
                home.microwave.door-
                dt*speed
            );
    }


    if(
        home.microwave.cooking
    ){

        home.microwave.cookTimer-=dt;

        if(
            home.microwave.cookTimer<=0
        ){

            home.microwave.cooking=false;

            home.microwave.cooked=true;

            home.task=3;

            /*
               Mikrodalga kapağı otomatik
               kapansın.
            */

            home.microwave.targetDoor=0;

            updateHomeObjective();

            showMessage(
                "🔔 BİP!<br>"+
                "Yemek pişti.<br>"+
                "Şimdi televizyonu aç."
            );
        }
    }
}


/* =========================================================
   DOLAP ANİMASYONU
========================================================= */

function updateCabinet(dt){

    if(
        home.cabinet.open<
        home.cabinet.target
    ){

        home.cabinet.open=
            Math.min(
                home.cabinet.target,
                home.cabinet.open+
                dt*2.5
            );
    }
}


/* =========================================================
   ETKİLEŞİM ANA
========================================================= */

function interact(){

    if(!started)
        return;


    if(game==="apartment"){

        if(
            escapeUnlocked &&
            distance(
                player.x,
                player.y,
                spawn.x,
                spawn.y
            )<1.6
        ){

            enterOasis();

            return;
        }

        collectPiece();

        return;
    }


    if(game==="oasis"){

        const d=
            distance(
                player.x,
                player.y,
                oasis.houseEntrance.x,
                oasis.houseEntrance.y
            );

        if(d<5){

            enterHouse();

        }else{

            showMessage(
                "Ev henüz biraz uzakta."
            );
        }

        return;
    }


    if(game==="house"){

        interactHouse();

        return;
    }


    if(game==="upstairs"){

        interactUpstairs();

        return;
    }
}


/* =========================================================
   67 TOPLA
========================================================= */

function collectPiece(){

    let nearest=null;
    let nd=Infinity;

    for(const piece of pieces){

        if(piece.taken)
            continue;

        const d=
            distance(
                player.x,
                player.y,
                piece.x,
                piece.y
            );

        if(d>1.5)
            continue;

        const a=
            Math.abs(
                angleDifference(
                    Math.atan2(
                        piece.y-player.y,
                        piece.x-player.x
                    ),
                    player.angle
                )
            );

        if(
            a<.55 &&
            d<nd
        ){

            nearest=piece;
            nd=d;
        }
    }


    if(!nearest){

        showMessage(
            "Burada 67 yok."
        );

        return;
    }


    nearest.taken=true;

    found++;


    document.getElementById(
        "objectiveText"
    ).textContent=
        found+
        " / 10 67";


    if(found===1){

        npc.active=true;

        npc.state="wander";

        npc.repathTimer=0;

        showMessage(
            "İlk 67'yi buldun.<br>"+
            "Bir şey uyandı."
        );

    }

    else if(found===3){

        showMessage(
            "Ayak sesleri..."
        );

    }

    else if(found===5){

        showMessage(
            "67 seni arıyor."
        );

    }

    else if(found===7){

        showMessage(
            "<b>SIX SEVEN.</b>"
        );

    }

    else if(found===9){

        showMessage(
            "Son 67."
        );

    }

    else if(found===10){

        escapeUnlocked=true;

        document.getElementById(
            "objectiveText"
        ).textContent=
            "Başladığın yere dön.";

        showMessage(
            "<b>10 / 10</b><br><br>"+
            "Kapı açıldı.<br>"+
            "Başladığın yere geri dön."
        );
    }
}


/* =========================================================
   VAHAYA GEÇ
========================================================= */

function enterOasis(){

    game="oasis";

    npc.active=false;

    player.x=0;
    player.y=0;

    player.angle=0;

    document.getElementById(
        "warning"
    ).style.opacity="0";

    updateHomeObjective();

    showMessage(
        "🌿 VAHAYA HOŞ GELDİN.<br><br>"+
        "Burada artık kaçman gerekmiyor.<br>"+
        "Evini bul."
    );
}


/* =========================================================
   YAKALANMA
========================================================= */

function caught(){

    started=false;

    showMessage(
        "67 seni yakaladı."
    );

    setTimeout(
        ()=>location.reload(),
        1200
    );
}


/* =========================================================
   BAŞLAT
========================================================= */

document.getElementById("start").onclick=()=>{

    started=true;

    document.getElementById(
        "menu"
    ).style.display="none";


    game="apartment";

    found=0;

    escapeUnlocked=false;


    player.x=spawn.x;
    player.y=spawn.y;
    player.angle=0;


    npc.x=12.5;
    npc.y=13.5;
    npc.angle=0;

    npc.active=false;
    npc.state="sleep";
    npc.path=[];
    npc.pathIndex=0;


    resetPieces();


    home.task=0;

    home.food=false;
    home.cookedFood=false;
    home.plate=false;

    home.eating=false;

    home.tv.on=false;

    home.cabinet.open=0;
    home.cabinet.target=0;
    home.cabinet.foodTaken=false;

    home.microwave.door=0;
    home.microwave.targetDoor=0;
    home.microwave.foodInside=false;
    home.microwave.cooking=false;
    home.microwave.cooked=false;


    document.getElementById(
        "objectiveText"
    ).textContent=
        "0 / 10 67";


    showMessage(
        "10 tane 67 bul.<br>"+
        "Sonra başladığın yere geri dön."
    );
};


/* =========================================================
   MESAJ
========================================================= */

function showMessage(text){

    const box=
        document.getElementById(
            "message"
        );

    box.innerHTML=text;

    box.style.opacity="1";

    clearTimeout(
        showMessage.timer
    );

    showMessage.timer=
        setTimeout(
            ()=>{
                box.style.opacity="0";
            },
            3500
        );
}


/* =========================================================
   ANA DÖNGÜ
========================================================= */

function loop(time){

    const dt=
        Math.min(
            .05,
            (time-lastTime)/1000
        );

    lastTime=time;
    currentTime=time;


    if(started){

        updatePlayer(dt);

        if(game==="apartment"){

            updateNPC(dt);

            drawApartment();

            drawEscapeDoor();

            drawNPC(time);

            drawPieces(time);

        }

        else if(game==="oasis"){

            drawOasis();

            /*
               Eve yaklaşınca bilgi
            */

            const d=
                distance(
                    player.x,
                    player.y,
                    oasis.houseEntrance.x,
                    oasis.houseEntrance.y
                );

            if(d<6){

                document.getElementById(
                    "objectiveText"
                ).textContent=
                    "🏠 Evin kapısına geldin. E'ye bas.";
            }

        }

        else if(
            game==="house"
        ){

            updateCabinet(dt);
            updateMicrowave(dt);

            drawHouseInterior();

        }

        else if(
            game==="upstairs"
        ){

            drawHouseInterior();

            /*
               Üst kat için yatağı
               ayrıca belirginleştir.
            */

            const p=
                worldToScreen(
                    home.bed.x,
                    home.bed.y
                );

            if(p){

                ctx.save();

                ctx.fillStyle=
                    "rgba(255,220,120,.15)";

                ctx.beginPath();

                ctx.arc(
                    p.x,
                    p.y,
                    60,
                    0,
                    Math.PI*2
                );

                ctx.fill();

                ctx.restore();
            }
        }


        /*
           Crosshair
        */

        ctx.beginPath();

        ctx.arc(
            W/2,
            H/2,
            3,
            0,
            Math.PI*2
        );

        ctx.fillStyle="white";

        ctx.fill();
    }


    requestAnimationFrame(loop);
}


requestAnimationFrame(loop);

