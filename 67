function drawOasisObject(
    obj,
    d,
    a
){

    const x=
        W/2+
        (
            a/
            (Math.PI/2)
        )*
        W/2;

    const perspective=
        H/
        Math.max(d,.5);


    if(obj.type==="tree"){

        const s=
            perspective*
            obj.size*
            1.5;

        const ground=
            H*.70+
            Math.min(
                100,
                d*2
            );


        ctx.fillStyle="#71452c";

        ctx.fillRect(
            x-s*.10,
            ground-s*.8,
            s*.2,
            s*.8
        );


        ctx.fillStyle="#246b36";

        ctx.beginPath();

        ctx.arc(
            x,
            ground-s*.95,
            s*.55,
            0,
            Math.PI*2
        );

        ctx.fill();


        ctx.fillStyle="#328548";

        ctx.beginPath();

        ctx.arc(
            x-s*.3,
            ground-s*1.1,
            s*.4,
            0,
            Math.PI*2
        );

        ctx.fill();


        ctx.beginPath();

        ctx.arc(
            x+s*.3,
            ground-s*1.08,
            s*.4,
            0,
            Math.PI*2
        );

        ctx.fill();
    }


    else if(obj.type==="rock"){

        const s=
            perspective*
            obj.size;

        const ground=
            H*.70+
            Math.min(
                100,
                d*2
            );

        ctx.fillStyle="#777";

        ctx.beginPath();

        ctx.ellipse(
            x,
            ground,
            s,
            s*.55,
            0,
            0,
            Math.PI*2
        );

        ctx.fill();
    }


    else if(obj.type==="flower"){

        const s=
            perspective*
            obj.size;

        const ground=
            H*.70+
            Math.min(
                100,
                d*2
            );

        ctx.fillStyle="#397c36";

        ctx.fillRect(
            x,
            ground-s*2,
            2,
            s*2
        );

        ctx.fillStyle="#ffe44e";

        ctx.beginPath();

        ctx.arc(
            x,
            ground-s*2,
            s*1.3,
            0,
            Math.PI*2
        );

        ctx.fill();
    }


    else if(obj.type==="lake"){

        const s=
            perspective*
            obj.size*2;

        const ground=H*.72;

        ctx.fillStyle="#36a9d8";

        ctx.beginPath();

        ctx.ellipse(
            x,
            ground,
            s*2,
            s*.8,
            0,
            0,
            Math.PI*2
        );

        ctx.fill();

        ctx.strokeStyle=
            "rgba(255,255,255,.4)";

        ctx.lineWidth=3;

        for(let i=-2;i<3;i++){

            ctx.beginPath();

            ctx.arc(
                x+i*s*.5,
                ground,
                s*.4,
                0,
                Math.PI
            );

            ctx.stroke();
        }
    }


    else if(obj.type==="house"){

        drawHouse(
            x,
            H*.70,
            perspective*obj.size
        );
    }
}


