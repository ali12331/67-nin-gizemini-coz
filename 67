========================================================= */

function drawHouseInterior(){

    /*
        Basit ama daha gerçekçi bir
        pseudo-3D raycaster.
    */

    const sky=
        ctx.createLinearGradient(
            0,0,0,H/2
        );

    sky.addColorStop(0,"#30261f");
    sky.addColorStop(1,"#8a6d52");

    ctx.fillStyle=sky;
    ctx.fillRect(0,0,W,H/2);


    const floor=
        ctx.createLinearGradient(
            0,H/2,0,H
        );

    floor.addColorStop(0,"#87613e");
    floor.addColorStop(1,"#3b2518");

    ctx.fillStyle=floor;
    ctx.fillRect(0,H/2,W,H/2);


    const rays=Math.min(W,1000);
    const column=W/rays;

    for(let i=0;i<rays;i++){

        const camera=i/rays-.5;

        const angle=
            player.angle+
            camera*(Math.PI/3);

        const d=
            castHouseRay(angle);

        const corrected=
            d*
            Math.cos(
                angle-player.angle
            );

        const height=
            H/
            Math.max(corrected,.01)
            *.95;

        const top=
            H/2-height/2;

        const light=
            clamp(
                190-corrected*10,
                35,
                190
            );

        ctx.fillStyle=
            `rgb(${light},${light*.78},${light*.58})`;

        ctx.fillRect(
            i*column,
            top,
            column+1,
            height
        );
    }


    drawHouseObjects();
}


function castHouseRay(angle){

    let d=0;

    const cos=Math.cos(angle);
    const sin=Math.sin(angle);

    while(d<30){

        d+=.025;

        const x=
            player.x+
            cos*d;

        const y=
            player.y+
            sin*d;

        if(houseWall(x,y))
            return d;
    }

    return 30;
}


