const HOUSE_W=14;
const HOUSE_H=10;


/*
    Ev içi haritası

    # duvar
    . zemin
*/

const HOUSE_MAP=[

"##############",
"#............#",
"#............#",
"#..####......#",
"#............#",
"#......###...#",
"#............#",
"#............#",
"#............#",
"##############"

];

function houseWall(x,y){

    const mx=Math.floor(x);
    const my=Math.floor(y);

    if(
        mx<0 ||
        my<0 ||
        mx>=HOUSE_W ||
        my>=HOUSE_H
    )
        return true;

    return HOUSE_MAP[my][mx]==="#";
}


function houseCanMove(x,y){

    const r=.22;

    return(
        !houseWall(x-r,y-r) &&
        !houseWall(x+r,y-r) &&
        !houseWall(x-r,y+r) &&
        !houseWall(x+r,y+r)
    );
}


function moveHousePlayer(mx,my){

    if(
        houseCanMove(
            player.x+mx,
            player.y
        )
    ){
        player.x+=mx;
    }

    if(
        houseCanMove(
            player.x,
            player.y+my
        )
    ){
        player.y+=my;
    }
}


