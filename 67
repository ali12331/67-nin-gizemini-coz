function worldToScreen(x,y){

    const dx=x-player.x;
    const dy=y-player.y;

    const d=Math.hypot(dx,dy);

    let a=
        Math.atan2(dy,dx)-
        player.angle;

    while(a>Math.PI)a-=Math.PI*2;
    while(a<-Math.PI)a+=Math.PI*2;

    if(Math.abs(a)>Math.PI/2)
        return null;

    const sx=
        W/2+
        (
            a/
            (Math.PI/2)
        )*
        W/2;

    const scale=
        H/
        Math.max(d,.3);

    const sy=
        H*.70;

    return{
        x:sx,
        y:sy,
        scale,
        distance:d,
        angle:a
    };
}


function drawCabinet(x,y,open){

    const p=worldToScreen(x,y);

    if(!p)
        return;

    const s=
        clamp(
            p.scale*.8,
            30,
            350
        );

    ctx.save();

    ctx.fillStyle="#76502f";

    ctx.fillRect(
        p.x-s*.4,
        p.y-s*.9,
        s*.8,
        s*.9
    );


    /*
       İç kısım
    */

    if(open>.05){

        ctx.fillStyle="#24170e";

        ctx.fillRect(
            p.x-s*.34,
            p.y-s*.82,
            s*.68,
            s*.74
        );


        if(!home.cabinet.foodTaken){

            ctx.fillStyle="#e9c45c";

            ctx.fillRect(
                p.x-s*.15,
                p.y-s*.35,
                s*.3,
                s*.15
            );
        }
    }


    /*
       Kapı animasyonu
    */

    ctx.save();

    ctx.translate(
        p.x-s*.4,
        p.y-s*.9
    );

    ctx.rotate(
        -open*.9
    );

    ctx.fillStyle="#946536";

    ctx.fillRect(
        0,
        0,
        s*.4,
        s*.9
    );

    ctx.restore();

    ctx.restore();
}


