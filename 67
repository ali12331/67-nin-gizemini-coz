========================================================= */

function oasisSolidAt(x,y,r=.35){

    for(const obj of oasis.objects){

        if(
            obj.type==="tree"
        ){

            const rr=
                .65+
                obj.size*.25;

            if(
                distance(
                    x,y,
                    obj.x,obj.y
                )<
                rr+r
            ){
                return true;
            }
        }


        if(
            obj.type==="rock"
        ){

            const rr=
                obj.size*.7;

            if(
                distance(
                    x,y,
                    obj.x,obj.y
                )<
                rr+r
            ){
                return true;
            }
        }


        if(
            obj.type==="lake"
        ){

            const dx=
                (x-obj.x)/(obj.size*2);

            const dy=
                (y-obj.y)/(obj.size*.8);

            if(
                dx*dx+
                dy*dy<
                1
            ){
                return true;
            }
        }

    }

    return false;
}


function moveOasisPlayer(mx,my){

    const nx=player.x+mx;
    const ny=player.y+my;

    if(
        Math.abs(nx)<70 &&
        Math.abs(ny)<50 &&
        !oasisSolidAt(nx,player.y,.28)
    ){
        player.x=nx;
    }

    if(
        Math.abs(player.x)<70 &&
        Math.abs(ny)<50 &&
        !oasisSolidAt(player.x,ny,.28)
    ){
        player.y=ny;
    }
}


