    for(let i=0;i<85;i++){

        let x,y;

        do{

            x=Math.random()*130-65;
            y=Math.random()*90-45;

        }while(
            distance(x,y,0,0)<8 ||
            distance(
                x,y,
                oasis.houseEntrance.x,
                oasis.houseEntrance.y
            )<8
        );

        oasis.objects.push({

            type:"tree",
            x,
            y,
            size:1+Math.random()*1.4

        });
    }


    /* Kayalar */

    for(let i=0;i<45;i++){

        oasis.objects.push({

            type:"rock",

            x:Math.random()*130-65,
            y:Math.random()*90-45,

            size:.4+Math.random()*.7
        });
    }


    /* Çiçekler */

    for(let i=0;i<130;i++){

        oasis.objects.push({

            type:"flower",

            x:Math.random()*130-65,
            y:Math.random()*90-45,

