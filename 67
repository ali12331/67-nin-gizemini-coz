function drawOasis(){

    const sky=
        ctx.createLinearGradient(
            0,0,0,H
        );

    sky.addColorStop(0,"#62c7ff");
    sky.addColorStop(.55,"#c7eeff");
    sky.addColorStop(1,"#91d66a");

    ctx.fillStyle=sky;
    ctx.fillRect(0,0,W,H);


    /* Güneş */

    ctx.fillStyle="rgba(255,244,170,.9)";

    ctx.beginPath();

    ctx.arc(
        W-100,
        100,
        48,
        0,
        Math.PI*2
    );

    ctx.fill();


    /* Uzak tepeler */

    ctx.fillStyle="#579d4e";

    ctx.beginPath();

    ctx.moveTo(0,H*.54);

    for(let x=0;x<=W;x+=60){

        const y=
            H*.48+
            Math.sin(x*.008)*30+
            Math.sin(x*.021)*15;

        ctx.lineTo(x,y);
    }

    ctx.lineTo(W,H);
    ctx.lineTo(0,H);

    ctx.fill();


    /* Zemin */

    ctx.fillStyle="#69b94f";

    ctx.fillRect(
        0,
        H*.55,
        W,
        H*.45
    );


    const visible=[];

    for(const obj of oasis.objects){

        const dx=obj.x-player.x;
        const dy=obj.y-player.y;

        const d=Math.hypot(dx,dy);

        if(d>90)
            continue;

        let a=
            Math.atan2(dy,dx)-
            player.angle;

        while(a>Math.PI)a-=Math.PI*2;
        while(a<-Math.PI)a+=Math.PI*2;

        if(Math.abs(a)>Math.PI/2)
            continue;

        visible.push({
            obj,
            distance:d,
            angle:a
        });
    }


    visible.sort(
        (a,b)=>b.distance-a.distance
    );


    for(const item of visible){

        drawOasisObject(
            item.obj,
            item.distance,
            item.angle
        );
    }
}


